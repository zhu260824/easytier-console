# 构建产物
/target/
/src-tauri/target/
**/*.rs.bk
*.pdb

# Tauri 自动生成的 schema（每次构建会重建）
/src-tauri/gen/

# 发布包产物（如需要请自行打包，不纳入版本控制）
/dist/
/package/

# 依赖目录
node_modules/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
*.bak
*.cache

# Python（图标生成脚本用的缓存）
__pycache__/
*.pyc

# 本地个人配置
#
# 说明：
#   dist/config/config.toml 是运行时配置，含真实网络名/密钥/peer 地址，
#   绝不可提交（整个 dist/ 已在上面被忽略）。
#   仓库里的示例模板是 config.example.toml。
#
/config.local.toml
/config.toml
/src-tauri/config.local.toml
.env
.env.*

# 本地推送脚本（个人环境用）
push-to-github.bat

# 打包产物（Release 上传用）
/build-release/
