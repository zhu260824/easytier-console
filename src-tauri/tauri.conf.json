{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easytier-console",
  "version": "1.1.2",
  "identifier": "com.easytier.console",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "EasyTier 控制台",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "EasyTier 网络控制台",
    "longDescription": "EasyTier 桌面控制台：查看节点状态、子网代理、端口转发与路由，一键启停核心"
  }
}
