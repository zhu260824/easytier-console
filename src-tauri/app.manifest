<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    EasyTier 控制台 —— 应用清单

    ★ 关键：requestedExecutionLevel = requireAdministrator

    为什么必须要求管理员权限：
      easytier-core 通过 wintun 驱动创建虚拟网卡（TUN 适配器），
      该操作需要加载内核驱动并修改网络配置，必须具备管理员权限。

      实测（非管理员 / Basic User 令牌下启动 core）：
        ERROR CORE::INSTANCE: tun device error err=rust tun error Failed to create adapter
        ERROR CORE: error=some instances stopped with errors

      同一个 exe、同一份配置，在管理员令牌下则正常：
        INFO CORE::INSTANCE: tun device ready dev="et_6_xxxx"

    副作用：双击时 Windows 会弹出 UAC 提示（「是否允许此应用对你的设备进行更改」），
    点「是」即可以管理员身份运行，之后点「启动」才能成功建网卡。
  -->
  <assemblyIdentity
      version="1.0.0.0"
      processorArchitecture="*"
      name="EasyTier.Console"
      type="win32"/>

  <description>EasyTier 网络控制台</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 声明支持的操作系统 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <!-- 高 DPI 支持 -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
